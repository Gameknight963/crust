<Rule Name="CrustLocal" DisplayName="Crust application" PageTemplate="debugger"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns="http://schemas.microsoft.com/build/2009/properties">
  <Rule.Metadata><sys:String x:Key="DebugTargetDropdownEnum">CrustDebugTarget</sys:String></Rule.Metadata>
  <Rule.DataSource><DataSource Persistence="UserFileWithXamlDefaults" HasConfigurationCondition="true" /></Rule.DataSource>
  <DynamicEnumProperty Name="CrustDebugTarget" EnumProvider="CrustDebugTargetProvider" Default="Project" Visible="false" />
  <StringProperty Name="CrustRunArguments" DisplayName="Command arguments" Description="Arguments passed to the executable. Quote arguments containing spaces." />
  <StringProperty Name="CrustRunWorkingDirectory" DisplayName="Working directory" Subtype="folder"
                  Description="Defaults to the manifest directory. Relative paths are resolved from the project file's directory." />
</Rule>
