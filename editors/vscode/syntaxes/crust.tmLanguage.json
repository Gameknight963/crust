{
  "scopeName": "source.crust",
  "name": "Crust",
  "fileTypes": ["cr"],
  "patterns": [
    { "name": "comment.line.double-slash.crust", "begin": "//", "end": "$" },
    { "name": "comment.block.crust", "begin": "/\\*", "end": "\\*/" },
    { "name": "string.quoted.double.crust", "begin": "\"", "end": "\"|$", "patterns": [{ "name": "constant.character.escape.crust", "match": "\\\\(x[0-9a-fA-F]+|[0-7]{1,3}|.)" }] },
    { "name": "string.quoted.single.crust", "begin": "'", "end": "'|$", "patterns": [{ "name": "constant.character.escape.crust", "match": "\\\\(x[0-9a-fA-F]+|[0-7]{1,3}|.)" }] },
    { "name": "keyword.control.directive.crust", "match": "^\\s*#\\s*(include|define|undef|if|ifdef|ifndef|elif|else|endif|pragma|error|warning|line)\\b" },
    {
      "match": "\\b(enum)(?:\\s+(class))?\\s+([a-zA-Z_][a-zA-Z_0-9]*)",
      "captures": {
        "1": { "name": "storage.type.crust" },
        "2": { "name": "storage.modifier.crust" },
        "3": { "name": "entity.name.type.crust" }
      }
    },
    {
      "match": "\\b(struct|union|interface)\\s+([a-zA-Z_][a-zA-Z_0-9]*)",
      "captures": {
        "1": { "name": "storage.type.crust" },
        "2": { "name": "entity.name.type.crust" }
      }
    },
    { "name": "storage.type.crust", "match": "\\b(int|float|double|char|signed|unsigned|short|long|bool|void|Self|u?int(8|16|32|64)_t|size_t|ptrdiff_t|u?intptr_t)\\b" },
    { "name": "constant.language.crust", "match": "\\b(true|false)\\b" },
    { "name": "storage.modifier.crust", "match": "\\b(const|volatile|static|typedef|extern|private|__cdecl|__stdcall|__fastcall|__vectorcall|__declspec)\\b" },
    { "name": "keyword.control.crust", "match": "\\b(return|if|else|while|do|for|switch|case|default|break|continue|unsafe|import)\\b" },
    { "name": "keyword.operator.word.crust", "match": "\\b(sizeof|alignof|_Alignof|init|destroy)\\b" },
    { "name": "support.function.crust", "match": "\\b(print|move)(?=\\s*\\()" },
    { "name": "entity.name.function.crust", "match": "~?[a-zA-Z_][a-zA-Z_0-9]*(?=\\s*\\()" },
    { "name": "constant.numeric.crust", "match": "\\b([0-9]+\\.[0-9]*([eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+)[fF]?(?![a-zA-Z_0-9])" },
    { "name": "constant.numeric.crust", "match": "\\b(0[xX][0-9a-fA-F]+|0[bB][01]+|0[0-7]*|[1-9][0-9]*)([uU](ll|LL|[lL])?|(ll|LL|[lL])[uU]?)?\\b" },
    { "name": "variable.language.crust", "match": "\\bthis\\b" },
    { "name": "keyword.operator.crust", "match": "::|->|<<=?|>>=?|==|!=|<=|>=|&&|\\|\\||[?:=+*/%!<>&|^~-]" }
  ]
}
